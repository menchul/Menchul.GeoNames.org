<?xml version="1.0" encoding="utf-8"?>
<Project>

    <PropertyGroup>
        <AssemblyCopyright>Menchul © 2026</AssemblyCopyright>
        <Copyright>Menchul © 2026</Copyright>
        <Version>3.0.0</Version>
        <Authors>Ivan Perehynets</Authors>
        <Company>Menchul</Company>
        <RepositoryUrl>https://github.com/menchul/Menchul.GeoNames.org</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Optimize>false</Optimize>
        <EnvironmentName>Development</EnvironmentName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
        <EnvironmentName>Production</EnvironmentName>
    </PropertyGroup>

    <PropertyGroup >
        <ApplicationIcon>..\..\Menchul.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup >
        <Content Include="..\..\Menchul.ico" />
    </ItemGroup>

    <Target Name="PreBuild" BeforeTargets="PreBuildEvent" Condition="'$(Configuration)'=='Debug'">
        <Exec Command="dotnet format $(ProjectFileName)" />
    </Target>

</Project>